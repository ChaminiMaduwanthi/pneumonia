# Copy to .env (optional). These are read via environment variables.

# Production model used when the client does not specify one.
DEFAULT_MODEL=densenet121

# Which models to load at startup: a model key, comma-separated keys, or "all".
PRELOAD_MODELS=densenet121

# Bind address for the service.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001
