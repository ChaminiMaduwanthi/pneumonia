# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# Google Gemini API key (server-side only). Get one from https://aistudio.google.com/apikey
# IMPORTANT: restrict the key to the "Generative Language API" in Google Cloud / AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model for the platform-helper chatbot.
GEMINI_MODEL=gemini-flash-latest
