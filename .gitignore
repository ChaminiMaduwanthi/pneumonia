# ── Secrets — never commit ────────────────────────────────────────────────
backend/.env
backend/.env.bak
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env*.local
ai-service/.env
!ai-service/.env.example

# ── Personal notes in Sinhala (admin password, live demo link) ────────────
viva.docx
viva-BACKUP.docx
run_Steps.docx

# ── Trained weights ───────────────────────────────────────────────────────
# GitHub rejects any file over 100 MB, and the three workspaces come to 1.4 GB.
# Only the deployed model is tracked; every other checkpoint is reproducible by
# re-running the training notebooks. The small training artefacts (logs, split
# file, confusion matrices, history plots) ARE tracked, because the reported
# results are derived from them.
models/**/*.keras
!models/DenseNet121/densenet121_workspace/DenseNet121_final.keras
models/**/*.h5
models/**/*.weights

# ── Node / Next.js ────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
frontend/.vercel

# ── Python AI service ─────────────────────────────────────────────────────
ai-service/.venv/
__pycache__/
*.py[cod]

# ── Runtime data ──────────────────────────────────────────────────────────
backend/uploads/xrays/*
backend/uploads/gradcam/*
!backend/uploads/xrays/.gitkeep
!backend/uploads/gradcam/.gitkeep

# ── Logs and OS noise ─────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
desktop.ini
